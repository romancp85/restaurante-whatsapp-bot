                    <div class="flex gap-2">
                        <input type="text" value="${opt.nombre}" onchange="updateOptionName(${gIdx}, ${oIdx}, this.value)" class="flex-1 px-2 py-1 text-xs bg-white border border-slate-100 rounded">
                        <input type="number" value="${opt.precioAdicional / 100}" onchange="updateOptionPrice(${gIdx}, ${oIdx}, this.value)" class="w-16 px-2 py-1 text-xs bg-white border border-slate-100 rounded">
                        <button type="button" onclick="removeOption(${gIdx}, ${oIdx})" class="text-slate-300"><i class="fas fa-minus-circle"></i></button>
                    </div>
                `).join('')}
                <button type="button" onclick="addOption(${gIdx})" class="text-[9px] font-bold text-indigo-500 hover:underline">+ Añadir opción</button>
            </div>
        </div>
    `).join('');
}

