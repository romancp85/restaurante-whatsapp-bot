// src/whatsapp/webhook.js - VERSIÓN COMPLETA ORIGINAL (300+ LÍNEAS) - REPARADA
import express from 'express';
import { getOrCreateCart, updateCart, addItemToCart, removeItemFromCart } from './cartUtils.js'; 
import { sendMessage, sendMenu, sendCartSummary, sendPaymentMethodOptions } from './utils.js';
import { getGlobalConfig } from '../services/configServiceDB.js'; 
import { processFinalOrder } from './orderProcessor.js';
import { analizarPedidoConIA } from '../utils/aiUtils.js'; 
import Restaurante from '../models/Restaurante.js'; // 🛑 Crucial para el Tenant
import MenuItem from '../models/MenuItem.js';       // 🛑 Crucial para el validador de IA
import logger from '../utils/logger.js';
import dotenv from 'dotenv';

dotenv.config();

const router = express.Router();
const VERIFY_TOKEN = process.env.WHATSAPP_VERIFY_TOKEN; 

// ----------------------------------------------------------------------
// FUNCIONES AUXILIARES PARA MENSAJES
// ----------------------------------------------------------------------

const enviarTexto = async (userId, texto) => {
    await sendMessage(userId, { type: "text", text: { body: texto } });
};


/**
 * Procesa lo que extrajo la IA y lo valida contra las REGLAS DE NEGOCIO reales.
 */
async function validarYProcesarExtraccionIA(aiResponse, businessId) {
    const itemsProcesados = [];
    logger.info(`[IA Debug] Procesando extracción: ${JSON.stringify(aiResponse.items)}`);

    for (const aiItem of aiResponse.items) {
        // 1. Búsqueda flexible: que el nombre esté contenido en el producto de la DB
        const productoReal = await MenuItem.findOne({ 
            businessId, 
            nombre: { $regex: new RegExp(aiItem.productName, 'i') } 
        });

        if (!productoReal) {
            logger.warn(`[IA Debug] No se encontró producto para: ${aiItem.productName}`);
            continue; 
        }

        const cantidadSaneada = Math.min(Math.max(1, aiItem.quantity), 20);
        const opcionesValidadas = [];
        let precioExtraTotal = 0;

        // 2. Mapeo de modificadores (Solo si existen en el producto real)
        if (aiItem.modifiers && productoReal.modificadores?.length > 0) {
            aiItem.modifiers.forEach(modNombre => {
                productoReal.modificadores.forEach(grupo => {
                    const opcionEncontrada = grupo.opciones.find(o => 
                        o.nombre.toLowerCase().includes(modNombre.toLowerCase())
                    );
                    if (opcionEncontrada) {
                        opcionesValidadas.push({
                            grupoNombre: grupo.nombre,
                            opcionNombre: opcionEncontrada.nombre,
                            precioExtra: opcionEncontrada.precioAdicional
                        });
                        precioExtraTotal += opcionEncontrada.precioAdicional;
                    }
                });
            });
        }

        itemsProcesados.push({
            itemId: productoReal._id,
            nombre: productoReal.nombre,
            precioUnitario: productoReal.precioBase + precioExtraTotal,
            quantity: cantidadSaneada, // ✅ AHORA COINCIDE CON addItemToCart
            opcionesSeleccionadas: opcionesValidadas,
            notes: aiItem.notes || ''
        });
    }

    return itemsProcesados;
}

/**
 * Procesa el mensaje de un cliente en función del estado de la conversación.
 */
async function handleStateFlow(userId, text, cart, businessId) { 
    const currentState = cart.conversationState;

    switch (currentState) {
        
        case 'INICIO':
        case 'EMPEZAR':
            // 🛑 Pasamos businessId para filtrar el catálogo
            await sendMenu(userId, businessId); 
            break;

        case 'MOSTRANDO_MENU':
            const menuSelection = parseInt(text);
            const selectedItem = cart.tempData.menuMap?.find(item => item.index === menuSelection);

            if (selectedItem) {
                cart.tempData.currentItemId = selectedItem.itemId;
                cart.tempData.itemName = selectedItem.nombre;
                // ✅ businessId incluido
                await updateCart(userId, businessId, { tempData: cart.tempData, conversationState: 'PREGUNTANDO_CANTIDAD' });
                await enviarTexto(userId, `¿Cuántas unidades de *${selectedItem.nombre}* deseas? (Solo el número)`);
            } else {
                return "TRY_AI"; 
            }
            break;
        
        case 'PREGUNTANDO_CANTIDAD':
            const quantity = parseInt(text);
            if (quantity > 0 && cart.tempData.currentItemId) {
                // ✅ Estructura SaaS: pasamos el objeto con itemId y quantity
                const result = await addItemToCart(userId, businessId, {
                    itemId: cart.tempData.currentItemId,
                    quantity: quantity
                });
                
                if (result.success) {
                    await updateCart(userId, businessId, { tempData: {}, conversationState: 'EN_CARRITO' });
                    await enviarTexto(userId, `¡Añadido! *${result.name}* (x${quantity}). Escribe *CARRITO* para revisar o *MENÚ* para seguir agregando.`);
                } else {
                    let errorMsg = "No pudimos añadir el producto.";
                    if (result.reason === 'SIN_STOCK') {
                        errorMsg = `❌ *${result.name}*: Solo quedan ${result.available || 0} unidades.`;
                    } else if (result.reason === 'PRODUCTO_NO_DISPONIBLE') {
                        errorMsg = `❌ El producto ya no está disponible.`;
                    }
                    await enviarTexto(userId, errorMsg);
                }
            } else {
                await enviarTexto(userId, "Por favor, ingresa una cantidad válida (solo números).");
            }
            break;

        case 'EN_CARRITO':
            await enviarTexto(userId, "Escribe *MENÚ* para agregar más o *FINALIZAR* para continuar.");
            break;

        case 'PREGUNTANDO_NOMBRE':
            const nombre = text.trim();
            if (nombre.length < 3) {
                await enviarTexto(userId, "Por favor, escribe tu nombre completo.");
            } else {
                cart.tempData.name = nombre;
                
                // 🛡️ LÓGICA REORDENADA: Si ya capturamos la dirección por IA, saltamos al pago
                if (cart.tempData.address && cart.tempData.address.length > 5) {
                    await updateCart(userId, businessId, { 
                        tempData: cart.tempData, 
                        conversationState: 'PREGUNTANDO_PAGO' 
                    });
                    await sendPaymentMethodOptions(userId, businessId);
                } else {
                    await updateCart(userId, businessId, { 
                        tempData: cart.tempData, 
                        conversationState: 'PREGUNTANDO_DIRECCION' 
                    });
                    await enviarTexto(userId, `¡Genial, ${nombre}! ¿Cuál es la *dirección completa* para la entrega?`);
                }
            }
            break;

        case 'PREGUNTANDO_DIRECCION':
            const entradaDireccion = text.trim();
            // Guardamos dirección y pasamos a pago
            cart.tempData.address = entradaDireccion;
            await updateCart(userId, businessId, { 
                tempData: cart.tempData, 
                conversationState: 'PREGUNTANDO_PAGO' 
            });
            await sendPaymentMethodOptions(userId, businessId);
            break;

        case 'PREGUNTANDO_PAGO':
            // Re-enviamos opciones si el usuario escribe en lugar de tocar botones
            await sendPaymentMethodOptions(userId, businessId);
            break;
            
        case 'CONFIRMANDO_PEDIDO':
            await enviarTexto(userId, "Escribe *CONFIRMAR* para procesar tu pedido o *CARRITO* para revisar.");
            break;
        
        case 'ESPERANDO_AGENTE':
            logger.info(`Cliente ${userId} en Handoff. Ignorando.`);
            break;

        default:
            await sendMenu(userId, businessId);
            break;
    }
}

/**
 * handleAICheck optimizada para asegurar que el carrito se actualice en la DB.
 */
async function handleAICheck(userId, text, cart, businessId, auth) {
    try {
        const aiResponse = await analizarPedidoConIA(text, businessId); 
        const itemsValidados = await validarYProcesarExtraccionIA(aiResponse, businessId);

        if (!itemsValidados || itemsValidados.length === 0) {
            logger.warn(`[IA] No se validaron items para el texto: ${text}`);
            return "NO_ITEMS"; 
        }
        
        // Añadir cada item al carrito
        for (const item of itemsValidados) {
            await addItemToCart(userId, businessId, item); 
        } 

        const addedNames = itemsValidados.map(r => `${r.quantity}x ${r.nombre}`).join(', ');
        let feedbackMessage = `✅ *¡Entendido!* He añadido: ${addedNames}.\n`;

        const clienteInfo = aiResponse.clienteInfo;
        // Si la IA detectó nombre y dirección, actualizamos y vamos a pago
        if (clienteInfo?.nombre && clienteInfo?.direccion && clienteInfo.direccion.length > 5) {
            await updateCart(userId, businessId, { 
                tempData: { 
                    ...cart.tempData, 
                    name: clienteInfo.nombre, 
                    address: clienteInfo.direccion 
                },
                conversationState: 'PREGUNTANDO_PAGO'
            });
            await sendMessage(userId, feedbackMessage, auth);
            await sendPaymentMethodOptions(userId, businessId, auth);
            return "AI_SUCCESS";
        }
        
        // Si solo fueron productos
        await updateCart(userId, businessId, { conversationState: 'EN_CARRITO' });
        await sendMessage(userId, `${feedbackMessage}\nEscribe *CARRITO* para ver tu pedido o *FINALIZAR* para pagar.`, auth);
        
        return "AI_SUCCESS"; // 👈 CRUCIAL: Esto evita el mensaje de "No logré entender"

    } catch (error) {
        logger.error('Error en handleAICheck:', error);
        return "ERROR";
    }
}

// ----------------------------------------------------------------------
// WEBHOOK PRINCIPAL (POST)
// ----------------------------------------------------------------------

router.post('/webhook', async (req, res) => {
    let userId = null;

    try {
        // 1. EXTRAER DATOS BÁSICOS DEL WEBHOOK
        const changes = req.body.entry?.[0]?.changes?.[0]?.value;
        const messageObject = changes?.messages?.[0];
        const metadata = changes?.metadata;

        if (!messageObject || !metadata) return res.sendStatus(200);

        userId = messageObject.from;
        const phoneIdReceptor = metadata.phone_number_id;

        // 2. BUSCAR AL RESTAURANTE (EL TENANT)
        const restaurante = await Restaurante.findOne({ whatsappPhoneId: phoneIdReceptor });
        if (!restaurante || !restaurante.activo) {
            logger.warn(`Mensaje para ID no registrado: ${phoneIdReceptor}`);
            return res.sendStatus(200);
        }

        // 3. DEFINIR VARIABLES DE CONTEXTO (BUSINESS ID Y AUTH)
        const businessId = restaurante._id;
        const auth = { 
            token: restaurante.whatsappToken, 
            phoneId: restaurante.whatsappPhoneId 
        };

        const text = (messageObject.text?.body || '').trim().toLowerCase(); 
        const normalizedText = text.toUpperCase();

        // 4. OBTENER CARRITO Y CONFIGURACIÓN
        let cart = await getOrCreateCart(userId, businessId);
        const config = await getGlobalConfig(businessId);
        const open = config?.isBusinessOpen ?? true;

        if (!open) {
            await sendMessage(userId, config?.closedMessage || "Cerrado.", auth);
            return res.sendStatus(200);
        }

        // --- MANEJAR INTERACCIONES (BOTONES DE PAGO) ---
        if (messageObject.interactive?.type === 'button_reply' && cart.conversationState === 'PREGUNTANDO_PAGO') {
            const interactiveData = messageObject.interactive.button_reply;
            if (interactiveData.id.startsWith('PAYMENT_')) {
            const method = interactiveData.id.replace('PAYMENT_', '').replace(/_/g, ' ');
            const cleanMethod = method.charAt(0).toUpperCase() + method.slice(1).toLowerCase(); 
            
            // Guardamos el pago y saltamos a CONFIRMANDO_PEDIDO
            cart = await updateCart(userId, businessId, { 
                tempData: { ...cart.tempData, paymentMethod: cleanMethod }, 
                conversationState: 'CONFIRMANDO_PEDIDO' 
            });

            // Ahora enviamos el resumen que dirá "Escribe CONFIRMAR"
            await sendCartSummary(userId, cart, businessId, auth);
            return res.sendStatus(200);
            }
        }

        // --- MANEJAR COMANDOS GLOBALES ---
        if (['MENÚ', 'MENU', 'HOLA'].includes(normalizedText)) {
            await sendMenu(userId, businessId, auth);
            return res.sendStatus(200);
        }
        
        if (normalizedText === 'CARRITO') {
            await sendCartSummary(userId, cart, businessId, auth);
            return res.sendStatus(200);
        }

if (normalizedText === 'FINALIZAR') {
    cart = await getOrCreateCart(userId, businessId); 

    if (!cart.items || cart.items.length === 0) {
        await sendMessage(userId, "Tu carrito está vacío. 🛒", auth);
        return res.sendStatus(200);
    }

    const tieneNombre = cart.tempData?.name && cart.tempData.name.length > 2;
    const tieneDireccion = cart.tempData?.address && cart.tempData.address.length > 5;

    if (tieneNombre && tieneDireccion) {
        // 1. Cambiamos el estado PRIMERO
        cart.conversationState = 'CONFIRMANDO_PEDIDO';
        await cart.save();

        // 2. Enviamos el resumen (que ahora detectará el nuevo estado y dirá "Escribe CONFIRMAR")
        await sendCartSummary(userId, cart, businessId, auth);
    } else {
        await updateCart(userId, businessId, { conversationState: 'PREGUNTANDO_NOMBRE' });
        await sendMessage(userId, "¡Perfecto! ¿Cuál es tu nombre completo?", auth);
    }
    
    return res.sendStatus(200);
}

        if (normalizedText.startsWith('QUITAR')) {
            const index = parseInt(normalizedText.split(' ')[1]);
            if (!isNaN(index)) {
                const result = await removeItemFromCart(userId, businessId, index); 
                if (result.success) {
                    const updatedCart = await getOrCreateCart(userId, businessId);
                    await sendCartSummary(userId, updatedCart, businessId, auth);
                } else {
                    await sendMessage(userId, "No encontré ese producto. 🧐", auth);
                }
            }
            return res.sendStatus(200);
        }

        if (normalizedText === 'CONFIRMAR' && cart.conversationState === 'CONFIRMANDO_PEDIDO') {
            // Volvemos a obtener el carrito para asegurar que el proceso tenga la última versión
            const freshCart = await getOrCreateCart(userId, businessId); 
            
            if (freshCart.items?.length > 0) {
                // Ejecutamos el procesador de órdenes
                await processFinalOrder(userId, freshCart, businessId, auth); 
                // Importante: El procesador ya borra el carrito y envía el mensaje de éxito.
            } else {
                await sendMessage(userId, "Tu carrito está vacío. 😅", auth);
            }
            return res.sendStatus(200);
        }

        // --- LÓGICA HÍBRIDA (IA / ESTADOS) ---
        const isNumeric = !isNaN(text.trim()) && text.trim().length < 3;

        if (isNumeric) {
            await handleStateFlow(userId, text, cart, businessId, auth);
            return res.sendStatus(200); 
        } 
        
        // Si no es un número, pasamos a la IA (Pilar 3: Extracción)
        const aiResult = await handleAICheck(userId, text, cart, businessId, auth);
        
        if (aiResult !== "AI_SUCCESS") {
            const stateResult = await handleStateFlow(userId, text, cart, businessId, auth);
            if (stateResult === "TRY_AI") {
                await sendMessage(userId, "No logré entender eso. 😅 Escribe *MENÚ*.", auth);
            }
        }

        return res.sendStatus(200);

    } catch (error) {
        logger.error('Error catastrófico en Webhook:', error);
        res.sendStatus(500);
    }
});

router.get('/webhook', (req, res) => {
    const mode = req.query['hub.mode'];
    const token = req.query['hub.verify_token'];
    const challenge = req.query['hub.challenge'];

    if (mode && token) {
        if (mode === 'subscribe' && token === VERIFY_TOKEN) {
            logger.info('WEBHOOK_VERIFIED');
            return res.status(200).send(challenge);
        }
    }
    return res.sendStatus(403);
});

export default router;
