export const upsertMenuItem = async (req, res) => {
    try {
        const { id, nombre, precioBase, categoria, descripcion, disponible, cantidad_diaria, tipoProducto } = req.body;
        
        const data = {
            nombre,
            precioBase: Math.round(parseFloat(precioBase) * 100), // Guardar como centavos
            categoria,
            descripcion,
            disponible,
            cantidad_diaria: parseInt(cantidad_diaria) || 99,
            tipoProducto: tipoProducto || 'simple',
            businessId: req.businessId // 🛡️ Seguridad: Siempre atado al dueño
        };

        if (id) {
            const updated = await MenuItem.findOneAndUpdate({ _id: id, businessId: req.businessId }, data, { new: true });
            return res.json(updated);
        } else {
            const nuevo = new MenuItem(data);
            await nuevo.save();
            return res.status(201).json(nuevo);
        }
    } catch (e) { res.status(400).json({ message: "Error al guardar" }); }
};

