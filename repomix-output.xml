// src/whatsapp/orderProcessor.js
import Pedido from '../models/Pedido.js';
import ShoppingCart from '../models/ShoppingCart.js';
import { sendMessage } from './utils.js';
import { getGlobalConfig } from '../services/configServiceDB.js'; 
import logger from '../utils/logger.js';

const FALLBACK_DELIVERY_COST = 3000;

/**
 * Obtiene el costo de envío específico del restaurante.
 */
const getDeliveryCost = async (businessId) => {
    try {
        const config = await getGlobalConfig(businessId);
        const cost = config?.costoEnvioCents; 
        return (typeof cost === 'number' && cost >= 0) ? cost : FALLBACK_DELIVERY_COST;
    } catch (error) {
        logger.error(`Error costo envío restaurante ${businessId}:`, error);
        return FALLBACK_DELIVERY_COST;
    }
};

/**
 * Procesa la orden final en modo SaaS.
 */
export const processFinalOrder = async (userId, cart, businessId, auth) => {
    const { clientPhone, items, tempData } = cart; 

    if (!items || items.length === 0) {
        await sendMessage(userId, "Carrito vacío. Escribe *MENÚ*.", auth);
        return null;
    }
    
    try {
        // 1. OBTENER CONFIGURACIÓN DINÁMICA
        const config = await getGlobalConfig(businessId);
        const costoEnvio = await getDeliveryCost(businessId);

        // 2. CÁLCULO DE TOTALES
        const subtotal = items.reduce((sum, item) => sum + (item.precioUnitario * item.cantidad), 0);
        const total = subtotal + costoEnvio;

        const metodoPago = tempData.paymentMethod || 'Efectivo';
        
        // 3. CREAR PEDIDO VINCULADO AL RESTAURANTE
        const nuevoPedido = new Pedido({
            businessId: businessId, // 🛑 Multi-tenant
            telefonoCliente: clientPhone,
            nombreCliente: tempData.name || 'Cliente WhatsApp',
            direccionEntrega: tempData.address || 'No especificada',
            items: items,
            subtotal,
            costoEnvio, 
            total,
            metodoPago, 
            estado: 'Pendiente', 
        });
        
        await nuevoPedido.save();
        logger.info(`[SaaS] Pedido #${nuevoPedido.numero_pedido} creado para el restaurante ${businessId}`);

        // 4. LIMPIEZA SEGURA DEL CARRITO
        // Borramos el carrito solo para este usuario Y este restaurante
        await ShoppingCart.deleteOne({ clientPhone: userId, businessId: businessId }); 

        // 5. MENSAJE DE CONFIRMACIÓN PERSONALIZADO
        let confirmText = `✅ *¡PEDIDO REGISTRADO!* (#${nuevoPedido.numero_pedido})\n\n`;
        confirmText += `Gracias *${nuevoPedido.nombreCliente}*, estamos preparando tu orden.\n`;
        confirmText += `\n*Detalles:*`;
        confirmText += `\n💰 Total: $${(total / 100).toFixed(2)}`;
        confirmText += `\n📍 Dirección: ${nuevoPedido.direccionEntrega}`;
        confirmText += `\n💳 Pago: ${nuevoPedido.metodoPago}`;

        // Datos de transferencia dinámicos
        if (metodoPago.toLowerCase() === 'transferencia') {
            confirmText += `\n\n*DATOS BANCARIOS:* \n${config.transferDetailsMessage || 'Consultar con el restaurante.'}`;
        }
        
        confirmText += "\n\nTe avisaremos cuando el repartidor vaya en camino. 🛵";
        
        await sendMessage(userId, confirmText, auth);

        return nuevoPedido;

    } catch (error) {
        logger.error(`Error FATAL en processFinalOrder para ${businessId}:`, error);
        await sendMessage(userId, "⚠️ Hubo un error al registrar tu pedido. Por favor intenta de nuevo.", auth);
        return null;
    }
};
