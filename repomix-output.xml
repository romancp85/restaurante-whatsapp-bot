    try {
        const updatedConfig = await GlobalConfig.findOneAndUpdate(
            { clientId: CONFIG_KEY },
            { $set: updateData },
            { new: true }
        );
        return updatedConfig;
    } catch (error) {
        logger.error('Error al actualizar la configuración global:', error.message);
        throw new Error('No se pudo actualizar la configuración.');
