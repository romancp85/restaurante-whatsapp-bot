// src/services/notifyService.js
import { sendMessage } from '../whatsapp/utils.js';
import logger from '../utils/logger.js';

/**
 * Notifica al Dashboard en tiempo real mediante WebSockets
 */
export const notifyDashboard = (businessId, pedido) => {
    if (!global.io) {
        logger.warn(`[notifyService] ⚠️ Socket.io no inicializado. No se pudo notificar al negocio ${businessId}`);
        return;
    }

    try {
        const salaId = businessId.toString();
        // Limpiamos el objeto para evitar errores de referencias circulares
        const dataFinal = JSON.parse(JSON.stringify(pedido));
        
        global.io.to(salaId).emit('NUEVO_PEDIDO', dataFinal);
        console.log(`📢 [notifyService] Dashboard notificado: Pedido #${dataFinal.numero_pedido} en sala ${salaId}`);
    } catch (error) {
        logger.error(`[notifyService] Error al emitir Socket: ${error.message}`);
    }
};

/**
 * Envía un mensaje de texto plano o interactivo por WhatsApp
 */
export const sendWhatsAppNotification = async (userId, payload, auth) => {
    try {
        // payload puede ser un string o un objeto interactivo
        await sendMessage(userId, payload, auth);
        console.log(`📩 [notifyService] WhatsApp enviado a ${userId}`);
    } catch (error) {
        logger.error(`[notifyService] Error enviando WhatsApp: ${error.message}`);
    }
};

/**
 * Envía la notificación de cambio de estado (Confirmado, En Camino, etc)
 */
export const notifyOrderStatusUpdate = async (pedido, nuevoEstado, auth) => {
    if (pedido.telefonoCliente === 'MOSTRADOR') return;

    let mensaje = "";
    const n = pedido.numero_pedido;
    
    if (nuevoEstado === 'Confirmado') mensaje = `✅ *¡Hola ${pedido.nombreCliente}!* Tu pedido #${n} ha sido confirmado y ya está en cocina. 👨‍🍳`;
    else if (nuevoEstado === 'En Camino') mensaje = `🛵 *¡Buenas noticias!* Tu pedido #${n} va en camino a tu dirección.`;
    else if (nuevoEstado === 'Entregado') mensaje = `🌟 *¡Pedido entregado!* Muchas gracias por tu compra. ¡Que lo disfrutes!`;

    if (mensaje) {
        await sendWhatsAppNotification(pedido.telefonoCliente, mensaje, auth);
    }
};
