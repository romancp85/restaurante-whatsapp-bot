        <nav class="flex-1 mt-4">
            <a href="#" onclick="showView('comandas')" id="nav-comandas" class="nav-item flex items-center gap-3 px-6 py-4 text-slate-500 font-semibold hover:bg-slate-50 transition-all border-r-4 border-transparent active-link">
                <i class="fas fa-th-large w-5"></i> Comandas Live
            </a>
            <a href="#" onclick="showView('catalogo')" id="nav-catalogo" class="nav-item flex items-center gap-3 px-6 py-4 text-slate-500 font-semibold hover:bg-slate-50 transition-all border-r-4 border-transparent">
                <i class="fas fa-utensils w-5"></i> Catálogo / Menú
            </a>
            <a href="#" onclick="showView('ajustes')" id="nav-ajustes" class="nav-item flex items-center gap-3 px-6 py-4 text-slate-500 font-semibold hover:bg-slate-50 transition-all border-r-4 border-transparent">
                <i class="fas fa-cog w-5"></i> Configuración
            </a>
        </nav>

        <!-- USER INFO & LOGOUT -->
        <div class="p-4 border-t border-slate-100 bg-slate-50/50">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold">
                    <span id="user-initial">U</span>
                </div>
                <div class="flex-1 min-w-0">
                    <p id="user-name" class="text-sm font-bold text-slate-800 truncate">Usuario</p>
                    <p id="user-role" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Admin</p>
                </div>
            </div>
            <button onclick="logout()" class="w-full flex items-center justify-center gap-2 py-2 px-4 bg-white border border-red-100 text-red-500 text-xs font-bold rounded-lg hover:bg-red-50 transition-all">
                <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
            </button>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        
        <!-- TOP HEADER -->
        <header class="bg-white border-b border-slate-200 py-4 px-8 flex justify-between items-center h-20">
            <div>
                <h2 id="view-title" class="text-xl font-black text-slate-800 uppercase tracking-tight">Comandas Live</h2>
                <p id="store-name" class="text-xs text-indigo-500 font-bold uppercase tracking-widest">Cargando...</p>
            </div>
            <div class="flex items-center gap-4">
                <div id="socket-status" class="flex items-center gap-2 bg-green-50 text-green-600 px-3 py-1 rounded-full text-[10px] font-black border border-green-200">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span> SYSTEM LIVE
                </div>
                <button onclick="openModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl text-xs font-black transition-all shadow-lg shadow-indigo-100 flex items-center gap-2">
                    <i class="fas fa-plus"></i> NUEVA ORDEN
                </button>
            </div>
        </header>

        <!-- SCROLLABLE CONTENT AREA -->
        <div id="content-area" class="flex-1 overflow-y-auto p-8">
            
            <!-- VISTA: COMANDAS (Por defecto) -->
            <section id="view-comandas" class="space-y-6">
                <!-- Stats en vista de comandas -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                        <p class="text-slate-400 text-[10px] font-black uppercase">Pendientes</p>
                        <h2 id="stat-pending" class="text-2xl font-black text-orange-500">0</h2>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                        <p class="text-slate-400 text-[10px] font-black uppercase">Cocina</p>
                        <h2 id="stat-kitchen" class="text-2xl font-black text-indigo-500">0</h2>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                        <p class="text-slate-400 text-[10px] font-black uppercase">Camino</p>
                        <h2 id="stat-delivery" class="text-2xl font-black text-emerald-500">0</h2>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                        <p class="text-slate-400 text-[10px] font-black uppercase">Ventas Hoy</p>
                        <h2 id="stat-sales" class="text-2xl font-black text-slate-800">$0.00</h2>
                    </div>
                </div>

                <div id="orders-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    <!-- Cards de órdenes inyectadas por JS -->
                </div>
            </section>

            <!-- VISTA: CATÁLOGO (Próximamente) -->
            <section id="view-catalogo" class="hidden space-y-6">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-800">Gestión de Menú</h3>
                        <p class="text-xs text-slate-400 font-medium">Administra tus productos, precios y extras.</p>
                    </div>
                    <button onclick="openProductModal()" class="bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-black shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all">
                        + NUEVO PRODUCTO
                    </button>
                </div>

                <!-- TABLA DE PRODUCTOS -->
                <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-50 border-b border-slate-100">
                            <tr>
                                <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Producto</th>
                                <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Categoría</th>
                                <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Precio</th>
                                <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Estado</th>
                                <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="catalog-table-body" class="divide-y divide-slate-50">
                            <!-- Se llena con JS -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- VISTA: AJUSTES (Próximamente) -->
            <section id="view-ajustes" class="hidden">
                <div class="bg-white p-12 rounded-3xl text-center border border-slate-100">
                    <i class="fas fa-sliders-h text-4xl text-slate-200 mb-4"></i>
                    <h3 class="text-xl font-black text-slate-800">Ajustes del Negocio</h3>
                    <p class="text-slate-400">Horarios, métodos de pago y links de WhatsApp.</p>
                </div>
            </section>

        </div>
    </main>

    <!-- MODAL NUEVA ORDEN DIRECTA (Igual al anterior) -->
<!-- MODAL NUEVA ORDEN DIRECTA (VERSION POS OMNICANAL) -->
<div id="modal-order" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl relative z-10 flex flex-col max-h-[90vh]">
        
        <div class="p-6 border-b border-slate-100 flex justify-between items-center">
            <h3 class="text-xl font-black text-slate-800">Nueva Orden Profesional</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600"><i class="fas fa-times"></i></button>
        </div>

        <div class="flex-1 overflow-y-auto p-6 grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- COLUMNA IZQUIERDA: CAPTURA -->
            <div class="space-y-6">
                <div>
                    <h4 class="text-[10px] font-black text-indigo-500 uppercase mb-3">1. Datos del Cliente</h4>
                    <input type="text" id="cust-name" placeholder="Nombre del cliente" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl mb-2 text-sm">
                    <input type="text" id="cust-phone" placeholder="Teléfono (opcional)" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm">
                </div>

                <div>
                    <h4 class="text-[10px] font-black text-indigo-500 uppercase mb-3">2. Agregar Producto</h4>
                    <select id="prod-select" onchange="renderModifiers()" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm mb-3 font-bold">
                        <option value="">Selecciona un producto...</option>
                    </select>
                    
                    <!-- Contenedor de Modificadores (Dinámico) -->
                    <div id="modifiers-container" class="space-y-2 mb-3 max-h-40 overflow-y-auto px-2"></div>

                    <button onclick="addItemToTempOrder()" class="w-full py-2 bg-slate-800 text-white text-[10px] font-black rounded-lg uppercase tracking-widest hover:bg-slate-700 transition-all">
                        + Añadir al pedido
                    </button>
                </div>

                <div>
                    <h4 class="text-[10px] font-black text-indigo-500 uppercase mb-3">3. Logística y Pago</h4>
                    <div class="flex gap-2 mb-3">
