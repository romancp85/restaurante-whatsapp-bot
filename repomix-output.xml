// src/queues/orderQueue.js
import { Queue } from 'bullmq';
import IORedis from 'ioredis';

const connection = new IORedis(process.env.REDIS_URL || 'redis://127.0.0.1:6379', {
    maxRetriesPerRequest: null
});

// 🌟 Nombre de la cola unificado
export const orderQueue = new Queue('order-processing', { connection });

export const enqueueOrder = async (source, data) => {
    // Usamos el messageId como jobId para evitar duplicados
    await orderQueue.add(
        'process-message', 
        { source, ...data },
        {
            jobId: data.messageId || `msg_${Date.now()}`, 
            removeOnComplete: true,
            removeOnFail: { age: 24 * 3600 } 
        }
    );
};
