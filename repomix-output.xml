<div id="modal-product" class="hidden fixed inset-0 z-[70] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeProductModal()"></div>
    <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl relative z-10 flex flex-col max-h-[90vh]">
        <div class="p-8 overflow-y-auto">
            <h3 id="product-modal-title" class="text-2xl font-black text-slate-800 mb-6">Nuevo Producto</h3>
            <form id="product-form" class="space-y-4">
            <input type="hidden" id="prod-id">
            
            <div>
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Nombre del Producto</label>
                <input type="text" id="prod-name-input" required class="w-full mt-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Precio ($)</label>
                    <input type="number" id="prod-price-input" required class="w-full mt-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Categoría</label>
                    <input type="text" id="prod-cat-input" placeholder="Ej: Pizzas" class="w-full mt-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
            </div>

            <!-- 🌟 ESTOS SON LOS CAMPOS QUE PROBABLEMENTE FALTAN 🌟 -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Stock Diario</label>
                    <input type="number" id="prod-stock-input" required class="w-full mt-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Tipo</label>
                    <select id="prod-type-input" class="w-full mt-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none font-bold">
                        <option value="simple">Simple (Soda/Lado)</option>
                        <option value="compuesto">Compuesto (Pizza/Burger)</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Descripción</label>
                <textarea id="prod-desc-input" class="w-full mt-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none h-20"></textarea>
            </div>
            
            <div class="flex items-center gap-3 p-4 bg-indigo-50 rounded-2xl">
                <input type="checkbox" id="prod-avail-input" checked class="w-5 h-5 text-indigo-600 rounded">
                <label for="prod-avail-input" class="text-sm font-bold text-indigo-700 uppercase tracking-tight">Disponible para venta</label>
            </div>

            <!-- Sección de Modificadores dentro del Modal -->
            <div class="mt-6 border-t border-slate-100 pt-6">
                <div class="flex justify-between items-center mb-4">
                    <h4 class="text-[10px] font-black text-indigo-500 uppercase tracking-widest">Configuración de Extras</h4>
                    <button type="button" onclick="addModifierGroup()" class="text-[10px] bg-indigo-50 text-indigo-600 px-2 py-1 rounded font-bold hover:bg-indigo-100">+ Añadir Grupo</button>
                </div>
                
                <!-- Aquí se inyectarán los grupos de modificadores -->
                <div id="modifiers-config-container" class="space-y-4">
                    <p class="text-center text-slate-300 text-[10px] py-4 italic">No hay extras configurados para este producto.</p>
                </div>
            </div>

            <button type="submit" class="w-full mt-6 bg-indigo-600 text-white font-black py-4 rounded-2xl hover:bg-indigo-700 transition-all uppercase tracking-widest text-xs shadow-lg">Guardar Producto</button>
        </form>
        </div>
    </div>
</div>

    <script>
    // 1. RECUPERAR DATOS
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user'));

    if (!token) {
        window.location.href = 'login.html';
    }

    // 2. CONFIGURACIÓN DEL SOCKET
    // === CONEXIÓN AL SOCKET ===
    console.log("🚀 Iniciando conexión...");
    
    const socket = io(window.location.origin, { 
        auth: { token: token },
        query: { token: token }, // Fallback para mayor compatibilidad
        transports: ['polling', 'websocket'] // Empieza por lo seguro y sube a lo rápido
    });

    socket.on('connect', () => {
        console.log("✅ CONEXIÓN ESTABLECIDA. ID:", socket.id);
    });

    socket.on('SERVER_READY', (data) => {
        console.log("📡 CONFIRMACIÓN:", data.message);
    });

    socket.on('connect_error', (err) => {
        console.error("❌ ERROR CRÍTICO:", err.message);
        if (err.message === "authentication_error") {
            alert("Tu sesión ha expirado. Por favor reingresa.");
            logout();
        }
    });

    socket.on('NUEVO_PEDIDO', (pedido) => {
        console.log("🎯 ¡PEDIDO RECIBIDO!", pedido);
        const sound = document.getElementById('notif-sound');
        if (sound) sound.play().catch(() => {});
        fetchOrders(); // Refrescar lista
    });

    // ESCUCHA DE PEDIDOS
    socket.on('NUEVO_PEDIDO', (pedido) => {
        console.log("🎯 ¡PEDIDO RECIBIDO POR SOCKET!", pedido);
        document.getElementById('notif-sound').play().catch(e => console.warn("Audio bloqueado"));
        fetchOrders(); 
    });

    // Llenar datos de usuario en la UI
    document.getElementById('user-name').innerText = user?.nombre || 'Admin';
    document.getElementById('user-initial').innerText = (user?.nombre || 'U').charAt(0).toUpperCase();
    document.getElementById('store-name').innerText = user?.restaurante || 'Cargando...';


    // === 3. NAVEGACIÓN ===
    // === 3. NAVEGACIÓN ENTRE VISTAS ===
    function showView(viewId) {
    console.log("Cambiando a vista:", viewId); // Para saber que el botón funciona

    // Ocultar todas las secciones
    document.querySelectorAll('section').forEach(s => s.classList.add('hidden'));
    // Quitar el color azul de todos los botones del menú lateral
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active-link'));
    
    // Mostrar la sección seleccionada
    const targetSection = document.getElementById(`view-${viewId}`);
    if (targetSection) targetSection.classList.remove('hidden');

    // Poner en azul el botón del menú lateral seleccionado
    const targetNav = document.getElementById(`nav-${viewId}`);
    if (targetNav) targetNav.classList.add('active-link');
    
    // Actualizar el título de la parte superior
    const titles = { 
        'comandas': 'Comandas Live', 
        'catalogo': 'Gestión de Catálogo', // 👈 Título actualizado
        'ajustes': 'Configuración del Negocio' 
    };
    document.getElementById('view-title').innerText = titles[viewId] || 'Panel';

    // 🌟 ESTA ES LA MAGIA: Cargar datos según la pestaña
    if (viewId === 'comandas') {
        fetchOrders(); // Refresca pedidos
    } else if (viewId === 'catalogo') {
        fetchCatalog(); // 👈 Llama a la función que descarga los productos
    }
}

    // === 4. LÓGICA DE NEGOCIO ===
    let menuItems = [];
    let tempOrderItems = [];
    let currentDeliveryMode = 'PICKUP';

    async function fetchOrders() {
        try {
            const res = await fetch(`/api/pedidos`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            if (res.status === 401) logout();
            const data = await res.json();
            renderOrders(data);
            updateStats(data);
        } catch (err) { console.error("Error cargando pedidos", err); }
    }

    async function fetchMenu() {
        try {
            const res = await fetch(`/api/menu`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            menuItems = await res.json();
            const select = document.getElementById('prod-select');
            if (select) {
                select.innerHTML = '<option value="">-- Selecciona --</option>' + 
                    menuItems.map(i => `<option value="${i._id}">${i.nombre} - $${(i.precioBase/100).toFixed(2)}</option>`).join('');
            }
        } catch (err) { console.error("Error menu", err); }
    }

    function renderOrders(pedidos) {
        const grid = document.getElementById('orders-grid');
        if (!pedidos || pedidos.length === 0) {
            grid.innerHTML = `<div class="col-span-full py-20 text-center text-slate-300 font-black uppercase tracking-widest">No hay pedidos</div>`;
            return;
        }

grid.innerHTML = pedidos.map(p => `
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden status-${p.estado.toLowerCase().replace(/\s/g, '')}">
        <div class="p-6">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        ${p.source === 'WHATSAPP' ? '<i class="fab fa-whatsapp text-green-500"></i>' : '<i class="fas fa-store text-blue-400"></i>'}
                        <span class="text-[10px] font-black text-slate-300 uppercase">${p.source}</span>
                    </div>
                    <h3 class="text-lg font-black text-slate-800 tracking-tighter">#${p.numero_pedido} - ${p.nombreCliente}</h3>
                </div>
                <span class="text-[9px] font-black px-2 py-1 rounded-lg bg-slate-100 text-slate-500 uppercase">${p.estado}</span>
            </div>

            <!-- 🌟 NUEVO: BADGE DE MODO DE ENTREGA -->
            <div class="mb-4">
                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${p.entregaMode === 'DELIVERY' ? 'bg-orange-100 text-orange-600' : 'bg-blue-100 text-blue-600'}">
                    ${p.entregaMode === 'DELIVERY' ? '<i class="fas fa-motorcycle mr-1"></i> A DOMICILIO' : '<i class="fas fa-shopping-bag mr-1"></i> PARA RECOGER'}
                </span>
            </div>

            <div class="space-y-3 mb-6">
                ${p.items.map(item => `
                    <div class="flex justify-between items-center text-sm">
                        <div class="font-bold text-slate-700">
                            <span class="text-indigo-600 mr-1">${item.cantidad}x</span> ${item.nombre}
                        </div>
                        <span class="text-xs font-bold text-slate-300">$${(item.precioUnitario/100).toFixed(2)}</span>
                    </div>
                    <!-- Mostrar extras si existen -->
                    ${item.opcionesSeleccionadas?.length > 0 ? 
                        item.opcionesSeleccionadas.map(opt => `<p class="text-[10px] text-slate-400 ml-5">+ ${opt.opcionNombre}</p>`).join('') 
                        : ''}
                `).join('')}
            </div>

            <!-- 📍 DIRECCIÓN (Solo si es domicilio) -->
            ${p.entregaMode === 'DELIVERY' ? `
                <div class="mb-6 p-3 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                    <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Entregar en:</p>
                    <p class="text-xs font-medium text-slate-600">${p.direccionEntrega}</p>
                </div>
            ` : ''}

            <div class="flex flex-col gap-2">
                ${getActionButtons(p)}
            </div>
            <p class="text-center text-[9px] font-bold text-slate-300 mt-4 uppercase">${new Date(p.createdAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</p>
        </div>
    </div>
`).join('');    }

    function getActionButtons(p) {
        const btnClass = "text-[10px] font-black py-3 rounded-2xl transition-all uppercase tracking-widest shadow-sm";
        if (p.estado === 'Pendiente') return `<button onclick="changeStatus('${p._id}', 'Confirmado')" class="${btnClass} bg-indigo-600 text-white hover:bg-indigo-700">Confirmar</button>`;
        if (p.estado === 'Confirmado' || p.estado === 'En Preparación') return `<button onclick="changeStatus('${p._id}', 'En Camino')" class="${btnClass} bg-emerald-500 text-white hover:bg-emerald-600">${p.entregaMode === 'PICKUP' ? 'Listo para Recoger' : 'Enviar Repartidor'}</button>`;
        if (p.estado === 'En Camino') return `<button onclick="changeStatus('${p._id}', 'Entregado')" class="${btnClass} bg-slate-800 text-white hover:bg-black">Archivar</button>`;
        return '';
    }

    async function changeStatus(id, nuevoEstado) {
        await fetch(`/api/pedidos/${id}/status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ nuevoEstado })
        });
        fetchOrders();
    }

    // === 5. MODAL POS OMNICANAL ===
    function openModal() { 
        document.getElementById('modal-order').classList.remove('hidden'); 
        document.body.classList.add('modal-active'); 
    }

    function closeModal() {
        document.getElementById('modal-order').classList.add('hidden');
        document.body.classList.remove('modal-active');
        
        // Limpieza segura (solo si existen los elementos)
        tempOrderItems = [];
        const idsToClear = ['cust-name', 'cust-phone', 'cust-address', 'prod-select'];
        idsToClear.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = "";
        });
        const modCont = document.getElementById('modifiers-container');
        if (modCont) modCont.innerHTML = "";
        
        renderTempOrder();
    }

    function logout() { localStorage.clear(); window.location.href = 'login.html'; }

    function setDeliveryMode(mode) {
        currentDeliveryMode = mode;
        const isDelivery = mode === 'DELIVERY';
        const addrField = document.getElementById('cust-address');
        if (addrField) addrField.classList.toggle('hidden', !isDelivery);
        
        document.getElementById('btn-pickup').className = `flex-1 py-2 rounded-lg text-[10px] font-black border-2 ${!isDelivery ? 'border-indigo-600 bg-indigo-50 text-indigo-600' : 'border-transparent bg-slate-100 text-slate-500'}`;
        document.getElementById('btn-delivery').className = `flex-1 py-2 rounded-lg text-[10px] font-black border-2 ${isDelivery ? 'border-indigo-600 bg-indigo-50 text-indigo-600' : 'border-transparent bg-slate-100 text-slate-500'}`;
    }

    function renderModifiers() {
        const productId = document.getElementById('prod-select').value;
        const item = menuItems.find(i => i._id === productId);
        const container = document.getElementById('modifiers-container');
        if (!container) return;
        container.innerHTML = '';

        if (item && item.modificadores) {
            item.modificadores.forEach(grupo => {
                const groupTitle = document.createElement('p');
                groupTitle.className = "text-[9px] font-bold text-slate-400 uppercase mt-2";
                groupTitle.innerText = grupo.nombre;
                container.appendChild(groupTitle);

                grupo.opciones.forEach(opt => {
                    const div = document.createElement('div');
                    div.className = "flex items-center justify-between bg-white p-2 rounded-lg border border-slate-100 mb-1";
                    div.innerHTML = `
                        <label class="text-xs font-medium text-slate-600 flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" class="mod-checkbox w-4 h-4 rounded text-indigo-600" 
                                data-group="${grupo.nombre}" data-name="${opt.nombre}" data-price="${opt.precioAdicional || 0}">
                            ${opt.nombre}
                        </label>
                        <span class="text-[10px] font-bold text-slate-400">+ $${((opt.precioAdicional || 0)/100).toFixed(2)}</span>
                    `;
                    container.appendChild(div);
                });
            });
        }
    }

    function addItemToTempOrder() {
        const productId = document.getElementById('prod-select').value;
        const item = menuItems.find(i => i._id === productId);
        if (!item) return alert("Selecciona un producto");

        const selectedModifiers = [];
        let extrasTotal = 0;
        
        document.querySelectorAll('.mod-checkbox:checked').forEach(cb => {
            const price = parseInt(cb.dataset.price);
            selectedModifiers.push({
                grupoNombre: cb.dataset.group,
                opcionNombre: cb.dataset.name,
                precioExtra: price
            });
            extrasTotal += price;
        });

        tempOrderItems.push({
            itemId: item._id,
            nombre: item.nombre,
            precioUnitario: item.precioBase + extrasTotal,
            opcionesSeleccionadas: selectedModifiers,
            cantidad: 1
        });

        renderTempOrder();
        document.getElementById('prod-select').value = "";
        document.getElementById('modifiers-container').innerHTML = "";
    }

    function renderTempOrder() {
        const list = document.getElementById('temp-items-list');
        const totalDisp = document.getElementById('temp-total');
        if (!list || !totalDisp) return;
        let total = 0;

        if (tempOrderItems.length === 0) {
            list.innerHTML = '<p class="text-center text-slate-400 text-xs py-10 italic">No hay productos aún</p>';
            totalDisp.innerText = "$0.00";
            return;
        }

        list.innerHTML = tempOrderItems.map((item, index) => {
            total += item.precioUnitario;
            return `
                <div class="bg-white p-3 rounded-xl border border-slate-200 relative mb-2">
                    <button onclick="removeTempItem(${index})" class="absolute -top-2 -right-2 bg-red-500 text-white w-5 h-5 rounded-full text-[10px] shadow-sm flex items-center justify-center">×</button>
                    <div class="flex justify-between items-start">
                        <span class="text-xs font-black text-slate-700">${item.nombre}</span>
                        <span class="text-xs font-black text-indigo-600">$${(item.precioUnitario/100).toFixed(2)}</span>
                    </div>
                    ${item.opcionesSeleccionadas.map(opt => `<p class="text-[9px] text-slate-400">+ ${opt.opcionNombre}</p>`).join('')}
                </div>
            `;
        }).join('');

        totalDisp.innerText = `$${(total / 100).toFixed(2)}`;
    }

    function removeTempItem(index) {
        tempOrderItems.splice(index, 1);
        renderTempOrder();
    }

    async function submitFinalOrder() {
        if (tempOrderItems.length === 0) return alert("Agrega al menos un producto");
        
        const payload = {
            customerName: document.getElementById('cust-name').value || "Cliente Directo",
            customerPhone: document.getElementById('cust-phone').value,
            metodoPago: document.getElementById('pay-method').value,
            deliveryMode: currentDeliveryMode,
            direccionEntrega: currentDeliveryMode === 'DELIVERY' ? document.getElementById('cust-address').value : 'RECOGIDA EN TIENDA',
            items: tempOrderItems
        };

        const btn = document.getElementById('btn-submit-order');
        btn.disabled = true;
        btn.innerText = "ENVIANDO...";

        try {
            const res = await fetch('/api/pedidos/directo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                closeModal();
                fetchOrders();
            } else {
                const errorData = await res.json();
                console.error("Error del servidor:", errorData);
                alert("Error del servidor: " + (errorData.message || "Desconocido"));
            }
        } catch (err) { 
            console.error("Fallo de red:", err);
            alert("Fallo al conectar con el servidor."); 
        } finally { 
            btn.disabled = false; 
            btn.innerText = "CREAR PEDIDO FINAL"; 
        }
    }

    function updateStats(pedidos) {
        document.getElementById('stat-pending').innerText = pedidos.filter(p => p.estado === 'Pendiente').length;
        document.getElementById('stat-kitchen').innerText = pedidos.filter(p => p.estado === 'Confirmado' || p.estado === 'En Preparación').length;
        document.getElementById('stat-delivery').innerText = pedidos.filter(p => p.estado === 'En Camino').length;
        const total = pedidos.reduce((acc, p) => acc + (p.total / 100), 0);
        document.getElementById('stat-sales').innerText = `$${total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}`;
    }

    // Lógica para cargar y renderizar el catálogo en la tabla
    async function fetchCatalog() {
        try {
            const res = await fetch(`/api/menu`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const items = await res.json();
            renderCatalog(items);
            
            // Actualizamos también el select del modal de órdenes con los datos frescos
            const select = document.getElementById('prod-select');
            if (select) {
                select.innerHTML = '<option value="">-- Selecciona --</option>' + 
                    items.map(i => `<option value="${i._id}">${i.nombre} - $${(i.precioBase/100).toFixed(2)}</option>`).join('');
            }
        } catch (err) { console.error("Error catálogo", err); }
    }

    function renderCatalog(items) {
        const tbody = document.getElementById('catalog-table-body');
        if (!tbody) return;

        tbody.innerHTML = items.map(i => `
            <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                    <p class="font-bold text-slate-800 text-sm">${i.nombre}</p>
                    <p class="text-[10px] text-slate-400 truncate max-w-[200px]">${i.descripcion || 'Sin descripción'}</p>
                </td>
                <td class="px-6 py-4">
                    <span class="px-2 py-1 bg-slate-100 text-slate-500 text-[9px] font-black rounded uppercase">${i.categoria}</span>
                </td>
                <td class="px-6 py-4 text-sm font-bold text-slate-700">
                    $${(i.precioBase / 100).toFixed(2)}
                </td>
                <td class="px-6 py-4">
                    <span class="flex items-center gap-1.5 ${i.disponible ? 'text-emerald-500' : 'text-red-400'} text-[10px] font-bold uppercase">
                        <span class="w-1.5 h-1.5 rounded-full ${i.disponible ? 'bg-emerald-500' : 'bg-red-400'}"></span>
                        ${i.disponible ? 'Activo' : 'Agotado'}
                    </span>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                    <button onclick="editProduct('${i._id}')" class="text-indigo-600 hover:text-indigo-900 transition-colors"><i class="fas fa-edit"></i></button>
                    <button onclick="deleteProduct('${i._id}')" class="text-red-300 hover:text-red-600 transition-colors"><i class="fas fa-trash"></i></button>
                </td>
            </tr>
        `).join('');
    }

    // Modales del Catálogo
    function openProductModal(isEdit = false) {
        document.getElementById('modal-product').classList.remove('hidden');
        document.getElementById('product-modal-title').innerText = isEdit ? 'Editar Producto' : 'Nuevo Producto';
    }

    function closeProductModal() {
        document.getElementById('modal-product').classList.add('hidden');
        document.getElementById('product-form').reset();
        document.getElementById('prod-id').value = "";
    }

    async function editProduct(id) {
    try {
        // Obtenemos los items directamente de la tabla o del API
        const res = await fetch(`/api/menu`, { headers: { 'Authorization': `Bearer ${token}` } });
        const items = await res.json();
        const i = items.find(item => item._id === id);
        
        if (i) {
            console.log("Editando producto:", i.nombre);
            
            // Llenar campos con seguridad
            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.value = val;
                else console.warn(`⚠️ No se encontró el campo con ID: ${id}`);
            };

            setVal('prod-id', i._id);
            setVal('prod-name-input', i.nombre);
            setVal('prod-price-input', i.precioBase / 100);
            setVal('prod-cat-input', i.categoria);
            setVal('prod-desc-input', i.descripcion || "");
            setVal('prod-stock-input', i.cantidad_diaria || 99);
            setVal('prod-type-input', i.tipoProducto || 'simple');
            
            const availCheck = document.getElementById('prod-avail-input');
            if (availCheck) availCheck.checked = i.disponible;

            // Al cargar los datos para editar
            currentProductModifiers = i.modificadores || []; // Cargamos los modificadores de la DB
            renderModifiersConfig(); // Dibujamos la interfaz de extras

            openProductModal(true);
        }
    } catch (err) {
        console.error("Error al cargar datos para editar:", err);
    }
}

let currentProductModifiers = []; // Almacén temporal mientras editamos

function addModifierGroup() {
    const newGroup = {
        nombre: "Nuevo Grupo (ej: Ingredientes)",
        minimo: 0,
        maximo: 1,
        permiteExcedente: true,
        opciones: [{ nombre: "Opción 1", precioAdicional: 0, disponible: true }]
    };
    currentProductModifiers.push(newGroup);
    renderModifiersConfig();
}

function renderModifiersConfig() {
    const container = document.getElementById('modifiers-config-container');
    if (currentProductModifiers.length === 0) {
        container.innerHTML = '<p class="text-center text-slate-300 text-[10px] py-4 italic">No hay extras configurados.</p>';
        return;
    }

    container.innerHTML = currentProductModifiers.map((grupo, gIdx) => `
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 relative">
            <button type="button" onclick="removeGroup(${gIdx})" class="absolute top-2 right-2 text-slate-300 hover:text-red-500"><i class="fas fa-times"></i></button>
            
            <div class="grid grid-cols-2 gap-2 mb-3">
                <input type="text" value="${grupo.nombre}" onchange="updateGroupName(${gIdx}, this.value)" placeholder="Nombre del grupo" class="col-span-2 px-3 py-2 text-xs font-bold bg-white border border-slate-200 rounded-lg outline-none">
                <div class="flex items-center gap-1">
                    <label class="text-[8px] font-black text-slate-400 uppercase">Min</label>
                    <input type="number" value="${grupo.minimo}" onchange="updateGroupMin(${gIdx}, this.value)" class="w-full px-2 py-1 text-xs bg-white border border-slate-200 rounded">
                </div>
                <div class="flex items-center gap-1">
                    <label class="text-[8px] font-black text-slate-400 uppercase">Max</label>
