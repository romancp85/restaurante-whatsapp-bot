    opcionesSeleccionadas: [{
        grupoNombre: String,
        opcionNombre: String,
        precioExtra: Number
    }],
    notas: { type: String, default: '' },
});

// 2. Definición del Esquema Principal (DEBE IR ANTES DE LOS ÍNDICES)
const shoppingCartSchema = new mongoose.Schema({
    clientPhone: {
        type: String,
        required: true,
    },
    businessId: { 
        type: mongoose.Schema.Types.ObjectId, 
        ref: 'Restaurante', 
        required: true 
    },
    items: [itemSchema],
    conversationState: {
        type: String,
        enum: [
            'INICIO',
            'EMPEZAR',
            'MOSTRANDO_MENU',
            'PREGUNTANDO_CANTIDAD',
            'EN_CARRITO',
            'PREGUNTANDO_NOMBRE',
            'PREGUNTANDO_DIRECCION',
            'PREGUNTANDO_PAGO',
            'CONFIRMANDO_PEDIDO',
