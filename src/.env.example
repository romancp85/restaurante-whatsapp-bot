# ============================================================
# .env.example — Copia este archivo a .env y rellena los valores
# NUNCA subas .env a git. Este archivo sí puede subirse.
# ============================================================

# --- Base de datos ---
MONGODB_URI=mongodb://localhost:27017/comandeo_pro

# --- Seguridad (genera valores aleatorios, mínimo 32 caracteres) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_SEGURO_DE_32_CHARS

# --- WhatsApp / Meta ---
# App Secret: lo encuentras en Meta for Developers > Tu App > Configuración básica
WHATSAPP_APP_SECRET=CAMBIAR_POR_TU_APP_SECRET_DE_META

# Token de verificación del Webhook: tú lo inventas, luego lo pones en Meta
VERIFY_TOKEN=CAMBIAR_POR_TOKEN_LARGO_Y_ALEATORIO

# Phone Number ID: Meta for Developers > WhatsApp > Configuración
WHATSAPP_PHONE_ID=TU_PHONE_NUMBER_ID

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CORS (origen del frontend en producción) ---
ALLOWED_ORIGIN=http://localhost:5173

# --- Opciones (con defaults razonables) ---
PORT=3000
MENU_CACHE_TTL=60

# --- OpenAI ---
OPENAI_API_KEY=sk-...
